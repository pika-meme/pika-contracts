# Only the fork tests read these; local tests need nothing. forge reads `.env` in this directory.

# test/fork/ — BSC mainnet fork (real Pancake Infinity and the real OpenFour mainnet Core).
RUN_PIKA_FORK=false
RPC_URL=
# Optional block to pin the fork to (0 or unset: latest).
PIKA_FORK_BLOCK=0

# test/openfour-fork/ — BSC testnet fork of a developer-owned OpenFour deployment (real, closed-source Core).
RUN_PIKA_OPENFOUR_FORK=false
TESTNET_RPC_URL=https://bsc-testnet.publicnode.com
# The fork's Registry and its owner's key (the owner is also the Core signer on a developer fork). Nothing is broadcast.
OPENFOUR_REGISTRY=
PRIVATE_KEY=
# The testnet quote token (mock USDT) for the second quote.
PONS_QUOTE=
